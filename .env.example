# Port the web interface is published on.
STORY_ARCHITECT_PORT=3000

# Host path used for the SQLite database, uploads, and the generated encryption key.
# On TrueNAS, point this at a dataset path, for example /mnt/tank/apps/story-architect.
STORY_ARCHITECT_DATA_PATH=./data

# Optional. 32 bytes as base64 or 64 hex characters. If unset, a key is generated
# in the data directory on first start. Back this value up with the database:
# credentials cannot be decrypted without it.
# STORY_ARCHITECT_ENCRYPTION_KEY=

# Optional. Used for OpenRouter attribution headers and documented links.
# PUBLIC_URL=https://stories.example.internal
